{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "script-type": "off",
    "long-title": "off",
    "heading-level": "warn",
    "no-raw-characters": "warn",
    "no-trailing-whitespace": "off",
    "attr-quotes": "error",
    "element-required-attributes": "error",
    "void-style": "off"
  }
}
