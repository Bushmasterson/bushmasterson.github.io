{
  "name": "bushmasterson.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "bushmasterson — developer portfolio",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,serve -c cyan,green \"npm:dev:watch\" \"npm:dev:serve\"",
    "dev:watch": "vite build --watch --mode development",
    "dev:serve": "serve -p 3000 .",
    "build": "vite build",
    "preview": "serve -p 3000 .",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint:prettier",
    "changelog": "npx git-cliff --output CHANGELOG.md",
    "clean": "rimraf assets/js dist _site .vite node_modules/.cache",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "html-minifier-terser": "^7.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.1",
    "serve": "^14.2.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "prettier --write"
    ],
    "*.{html,htm,css,json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
