# ============================================
# Line endings — normalize everything to LF
# ============================================
* text=auto eol=lf

*.html      text eol=lf
*.htm       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.less      text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.mts       text eol=lf
*.cts       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.svg       text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.avif      binary
*.ico       binary
*.bmp       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.7z        binary
*.rar       binary
*.exe       binary
*.dll       binary
*.so       binary
*.wasm      binary
*.mp3       binary
*.mp4       binary

package-lock.json   merge=ours -diff
pnpm-lock.yaml      merge=ours -diff
yarn.lock           merge=ours -diff

assets/icons/**     linguist-vendored
assets/icons/**     linguist-generated
assets/js/**        linguist-generated
assets/js/**        linguist-detectable=false
package-lock.json   linguist-generated
package-lock.json   linguist-detectable=false
_site/**            linguist-generated
dist/**             linguist-generated

*.md                linguist-documentation
docs/**             linguist-documentation

.github/            export-ignore
.vscode/            export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
.prettierrc         export-ignore
.prettierignore     export-ignore
.editorconfig       export-ignore
tsconfig.json       export-ignore
vite.config.ts      export-ignore
package.json        export-ignore
package-lock.json   export-ignore
node_modules/       export-ignore